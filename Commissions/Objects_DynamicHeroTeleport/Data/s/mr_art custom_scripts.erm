!!UN:C(hero)/26/4/?(heroId:y);
!!if&(heroId)=(HERO_ROLAND);
  !!UN:C(hero)/4/2/?(heroZ:y);
  !!if&(heroZ)>0; // if hero is in the underworld
    !!UN:Cx1/(STRUCT_HOOK_CONTEXT_EAX)/4/2; set radius = 2
    !!UN:Cx1/(STRUCT_HOOK_CONTEXT_RET)/4/5129161;
  !!en;
!!en;


8) сделать так, чтобы посадка на корабль/высадка с него занимала не весь оставшийся ход, а ровно 1000 мувпоинтов или остаток, если их меньше:
!?FU(mrart_OnHeroBoarding);
!!UN:Cx1/(STRUCT_HOOK_CONTEXT_ESI)/4/?(hero:y) C(hero)/26/4/?(heroId:y);
!!FU(mrart_Hero_AdjustBoardingCost):P(heroId);
!!SN:X?y99/0;                            [skip default]
!!UN:Cx1/(STRUCT_HOOK_CONTEXT_RET)/4/d2; [lol works for boarding/unboarding]

!?FU(mrart_Hero_AdjustBoardingCost);
!#VA(heroId:x);
!!HE(heroId):S(SKILL_NAVIGATION)/?(skillLvl:y) X?t/?s/d/d/d/d/d; [calc skills bonus]
!!VR(skillLvl:y)&t=0/s=(SKILL_NAVIGATION):+1;                    [+1 for speciality]
!!HE(heroId):W?(currentPoints:y)/1;

!!VR(cost:y):S1000;                                              [* (skillLvl:y) +600;                          [200-600]
!!VR(currentPoints):-(cost) F0/(INT_MAX);                        [decrease and limit value]
!!HE(heroId):W(currentPoints:y)/1;                               [set new cost no redraw]


