!!if&-1000;
  !!VRv4115:S0;
  !!VRv4116:S0;
  !!VRv4117:S0;
  !!VRv4135:S0;  [initialization for FU(WOG_Artificer_OfferUpgrade)]

  !!DO(WOG_Artificer_OfferUpgrade)/1/14/1&v160<3:P;

  !!VRv4135&v4115>0:Sv4115;
