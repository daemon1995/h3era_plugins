; ERM 2 functions shared by the legacy dialog adapter below.
; This file is appended to the standalone script; do not load it as another script.

!?FU(WOG_Artificer_GetUpgradeInfo);
; Pure recipe lookup. Returns NO_ART and zero costs for an unsupported source.
!#VA(artifact:x) (boosted:x) (enchanted:x) (target:x) (gold:x) (mithril:x);
!!VR(target):S(NO_ART);
!!VR(gold):S0;
!!VR(mithril):S0;
; Four ordinary weapon/armor chains, each ending at its sixth item.
!!if&(artifact)>=7/(artifact)<=29;
  !!VR(chainOffset:y):S(artifact)-7 %6;
  !!VR(target)&(chainOffset)<5:S(artifact)+1;
!!en;
!!VR(target)&(artifact)>=31/(artifact)<=35:S(artifact)+1;
!!VR(target)&(artifact)>=37/(artifact)<=39:S(artifact)+1;
!!VR(target)&(artifact)>=41/(artifact)<=43:S(artifact)+1;
!!VR(target)&(artifact)>=54/(artifact)<=55:S(artifact)+1;
!!VR(target)&(artifact)>=57/(artifact)<=58:S(artifact)+1;
!!VR(target)&(artifact)>=60/(artifact)<=61:S(artifact)+1;
!!VR(target)&(artifact)>=63/(artifact)<=64:S(artifact)+1;
!!VR(target)&(artifact)>=66/(artifact)<=67:S(artifact)+1;
!!VR(target)&(artifact)>=73/(artifact)<=74:S(artifact)+1;
!!VR(target)&(artifact)>=76/(artifact)<=77:S(artifact)+1;
!!VR(target)&(artifact)>=118/(artifact)<=121:S(artifact)+1;
!!VR(target)&(artifact)=45:S108;
!!VR(target)&(artifact)=69:S99;
!!VR(target)&(artifact)=70:S98;
!!VR(target)&(artifact)=71:S123;
!!VR(target)&(artifact)=83:S126;
!!VR(target)|(artifact)=94/(artifact)=95:S96;
!!VR(target)&(artifact)=97:S99;
!!VR(target)&(artifact)=116:S115;
!!VR(target)&(artifact)=117:S116;
!!FU&(target)=(NO_ART):E;

!!VR(gold)|(artifact)=7/(artifact)=13/(artifact)=19/(artifact)=25/(artifact)=76/(artifact)=118:S1000;
!!VR(gold)|(artifact)=8/(artifact)=14/(artifact)=20/(artifact)=26/(artifact)=54/(artifact)=57/(artifact)=60/(artifact)=63/(artifact)=66/(artifact)=73/(artifact)=119:S1500;
!!VR(gold)|(artifact)=9/(artifact)=15/(artifact)=21/(artifact)=27/(artifact)=31/(artifact)=37/(artifact)=41/(artifact)=77/(artifact)=120:S2000;
!!VR(gold)|(artifact)=10/(artifact)=16/(artifact)=22/(artifact)=28/(artifact)=117/(artifact)=121:S2500;
!!VR(gold)|(artifact)=38/(artifact)=42/(artifact)=55/(artifact)=58/(artifact)=61/(artifact)=64/(artifact)=67/(artifact)=74/(artifact)=116:S3000;
!!VR(gold)|(artifact)=32/(artifact)=39/(artifact)=43/(artifact)=94/(artifact)=95:S4000;
!!VR(gold)|(artifact)=45/(artifact)=71:S5000;
!!VR(gold)&(artifact)=33:S6000;
!!VR(gold)|(artifact)=11/(artifact)=17/(artifact)=23/(artifact)=29/(artifact)=70:S7500;
!!VR(gold)|(artifact)=34/(artifact)=69/(artifact)=97:S8000;
!!VR(gold)|(artifact)=35/(artifact)=83:S10000;

!!VR(mithril)|(artifact)=11/(artifact)=17/(artifact)=23/(artifact)=29/(artifact)=45:S1;
!!VR(mithril)&(artifact)=31:S2;
!!VR(mithril)&(artifact)=70:S3;
!!VR(mithril)&(artifact)=32:S4;
!!VR(mithril)&(artifact)=83:S5;
!!VR(mithril)&(artifact)=33:S6;
!!VR(mithril)&(artifact)=34:S8;
!!VR(mithril)&(artifact)=35:S10;
!!VR(gold)&(artifact)=76/(enchanted)=1:S1500;
!!VR(gold)&(artifact)=77/(enchanted)=1:S3000;
!!VR(gold)&(artifact)=57/(boosted)=1:+1000;
!!VR(gold)&(artifact)=58/(boosted)=1:+1000;

!?FU(WOG_Artificer_GetBannedTomesMask);
; Read bans at the point of use; v1 is also a dialog result and the AI difficulty scratch variable.
!#VA(mask:x);
!!VR(mask):S0;
!!VR(bit:y):S1;
!!re (artifact:y)/86/89;
  !!UN:A(artifact)/?(banned:y);
  !!VR(mask)&(banned)<>(FALSE):+(bit);
  !!VR(bit):*2;
!!en;

!?FU(WOG_Artificer_GetExchangeInfo);
; bannedTomes: bits 0..3 = Fire, Air, Water, Earth. Other historical ban checks are unchanged.
!#VA(artifact:x) (enchanted:x) (bannedTomes:x);
!#VA(first:x) (second:x) (third:x) (gold:x) (mithril:x);
!#VA(group[4]:y);
!!VR(group[0]):C-1/-1/-1/-1;
!!VR(first):S0;
!!VR(second):S0;
!!VR(third):S0;
!!VR(gold):S0;
!!VR(mithril):S0;
!!VR(group[0])&(artifact)>=46/(artifact)<=48:C46/47/48/-1;
!!VR(group[0])&(artifact)>=49/(artifact)<=51:C49/50/51/-1;
!!VR(group[0])|(artifact)=52/(artifact)=53:C52/53/-1/-1;
!!VR(group[0])&(artifact)>=79/(artifact)<=82:C79/80/81/82;
!!VR(group[0])|(artifact)=84/(artifact)=85:C84/85/-1/-1;
!!VR(group[0])&(artifact)=86:C87/88/89/-1;
!!VR(group[0])&(artifact)=87:C86/88/89/-1;
!!VR(group[0])&(artifact)=88:C87/86/89/-1;
!!VR(group[0])&(artifact)=89:C87/88/86/-1;
!!VR(group[0])|(artifact)=94/(artifact)=95:C94/95/-1/-1;
!!VR(group[0])|(artifact)=103/(artifact)=104:C103/104/-1/-1;
!!VR(group[0])|(artifact)=112/(artifact)=114:C112/114/-1/-1;
!!VR(group[0])|(artifact)=109/(artifact)=110/(artifact)=111/(artifact)=113:C109/110/111/113;

!!VR(count:y):S0;
!!re (index:y)/0/3;
  !!VR(candidate:y):S(group[index]);
  !!co|(candidate)<0/(candidate)=(artifact);
  !!if&(candidate)>=86/(candidate)<=89;
    !!VR(bit:y):S1;
    !!VR(bit)&(candidate)=87:S2;
    !!VR(bit)&(candidate)=88:S4;
    !!VR(bit)&(candidate)=89:S8;
    !!VR(banned:y):S(bannedTomes) &(bit);
    !!co&(banned)<>0;
  !!en;
  !!VR(out:y):S(@first)+(count);
  !!VRx(out):S(candidate);
  !!VR(count):+1;
!!en;
!!FU&(count)=0:E;

!!VR(gold)&(artifact)>=46/(artifact)<=53:S1000;
!!VR(gold)|(artifact)=103/(artifact)=104:S1000;
!!VR(gold)|(artifact)=84/(artifact)=85/(artifact)=112/(artifact)=114:S1500;
!!VR(gold)&(artifact)>=79/(artifact)<=82:S2500;
!!VR(gold)|(artifact)=94/(artifact)=95/(artifact)=109/(artifact)=110/(artifact)=111/(artifact)=113:S2500;
!!VR(gold)&(artifact)>=86/(artifact)<=89:S10000;
!!VR(mithril)&(artifact)>=79/(artifact)<=82:S1;
!!VR(mithril)&(artifact)>=86/(artifact)<=89:S10;
!!VR(mithril)|(artifact)=103/(artifact)=104:S1;
!!if&(enchanted)=1;
  !!VR(gold)|(artifact)=103/(artifact)=104:S7500;
  !!VR(mithril)&(artifact)>=79/(artifact)<=82:S3;
!!en;

!?FU(WOG_Artificer_GetCombinationInfo);
; Recipe ID 1..3. Six explicit component outputs also support an eventual C ABI.
!#VA(recipe:x) (enchanted:x) (target:x) (count:x) (parts[6]:x) (gold:x) (mithril:x);
!!VR(target):S(NO_ART);
!!VR(count):S0;
!!VR(parts[0]):C0/0/0/0/0/0;
!!VR(gold):S0;
!!VR(mithril):S0;
!!if&(recipe)=1;
  !!VR(target):S153;
  !!VR(count):S2;
  !!VR(parts[0]):C37/45;
  !!VR(gold):S5000;
  !!VR(gold)&(enchanted)=1:S7500;
  !!VR(mithril):S5;
!!el&(recipe)=2;
  !!VR(target):S108;
  !!VR(count):S6;
  !!VR(parts[0]):C46/47/48/49/50/51;
  !!VR(gold):S2500;
!!el&(recipe)=3;
  !!VR(target):S93;
  !!VR(count):S4;
  !!VR(parts[0]):C79/80/81/82;
  !!VR(gold):S10000;
  !!VR(mithril):S10;
!!en;

!?FU(WOG_Artificer_GetSlotEligibility);
; Legacy equipment list index 0..12 or 18, with recipe lookup shared across both services.
!#VA(artifact:x) (slot:x) (service:x) (bannedTomes:x) (eligible:x);
!!VR(eligible):S(FALSE);
!!FU|(artifact)<7/(artifact)>=(ART_META_SPELLBOOK):E;
!!FU&(slot)>12/(slot)<>18:E;
!!FU&(slot)<0:E;
!!if&(service)=1;
  !!FU(WOG_Artificer_GetUpgradeInfo):P(artifact)/i^wog_102_enabled^/i^wog_71_enabled^/?(target:y)/?(gold:y)/?(mithril:y);
  !!FU&(target)=(NO_ART):E;
  ; Preserve the slot restrictions of the original script, including miscellaneous slots.
  !!VR(eligible)&(slot)=0/(artifact)>=19/(artifact)<=23:S(TRUE);
  !!VR(eligible)&(slot)=1/(artifact)=42:S(TRUE);
  !!VR(eligible)&(slot)=1/(artifact)=55:S(TRUE);
  !!VR(eligible)&(slot)=1/(artifact)=58:S(TRUE);
  !!VR(eligible)&(slot)=1/(artifact)=83:S(TRUE);
  !!if&(slot)=2;
    !!VR(eligible)|(artifact)=33/(artifact)=43/(artifact)=54/(artifact)=57/(artifact)=66/(artifact)=71/(artifact)=76/(artifact)=97:S(TRUE);
  !!en;
  !!VR(eligible)&(slot)=3/(artifact)>=7/(artifact)<=11:S(TRUE);
  !!VR(eligible)&(slot)=3/(artifact)=35:S(TRUE);
  !!VR(eligible)&(slot)=3/(artifact)=38:S(TRUE);
  !!VR(eligible)&(slot)=4/(artifact)>=13/(artifact)<=17:S(TRUE);
  !!VR(eligible)&(slot)=4/(artifact)=34:S(TRUE);
  !!VR(eligible)&(slot)=4/(artifact)=39:S(TRUE);
  !!VR(eligible)&(slot)=5/(artifact)>=25/(artifact)<=29:S(TRUE);
  !!VR(eligible)&(slot)=5/(artifact)=31:S(TRUE);
  !!if|(slot)=6/(slot)=7;
    !!VR(eligible)|(artifact)=37/(artifact)=45/(artifact)=67/(artifact)=69/(artifact)=70/(artifact)=77/(artifact)=94/(artifact)=95:S(TRUE);
  !!en;
  !!VR(eligible)&(slot)=8/(artifact)=32:S(TRUE);
  !!VR(eligible)&(slot)=8/(artifact)=41:S(TRUE);
  !!if|(slot)>=9/(slot)=18;
    !!VR(eligible)&(artifact)>=60/(artifact)<=64:S(TRUE);
    !!VR(eligible)&(artifact)>=73/(artifact)<=74:S(TRUE);
    !!VR(eligible)&(artifact)>=116/(artifact)<=121:S(TRUE);
  !!en;
  !!if|(artifact)=71/(artifact)=83;
    !!UN:A(target)/?(banned:y);
    !!VR(eligible)&(banned)<>(FALSE):S(FALSE);
  !!en;
!!el&(service)=2;
  !!FU(WOG_Artificer_GetExchangeInfo):P(artifact)/i^wog_71_enabled^/(bannedTomes)/?(first:y)/?(second:y)/?(third:y)/?(gold:y)/?(mithril:y);
  !!FU&(first)=0:E;
  !!VR(eligible)&(slot)=1/(artifact)=109:S(TRUE);
  !!VR(eligible)&(slot)=2/(artifact)>=103/(artifact)<=104:S(TRUE);
  !!if|(slot)=6/(slot)=7;
    !!VR(eligible)|(artifact)=94/(artifact)=95/(artifact)=110/(artifact)=113:S(TRUE);
  !!en;
  !!if|(slot)>=9/(slot)=18;
    !!VR(eligible)&(artifact)>=46/(artifact)<=53:S(TRUE);
    !!VR(eligible)&(artifact)>=79/(artifact)<=89:S(TRUE);
    !!VR(eligible)|(artifact)=111/(artifact)=112/(artifact)=114:S(TRUE);
  !!en;
!!en;

!?FU(WOG_Artificer_SpendMovement);
!#VA(hero:x) (cost:x);
!!HE(hero):W?(movement:y);
!!VR(movement):-(cost) F0/(INT_MAX);
!!HE(hero):W(movement);

!?FU(WOG_Artificer_RecordOrder);
!#VA(x:x) (y:x) (z:x) (oldFatigue:x) (fatigue:x);
!!VR(fatigue):S(oldFatigue)+1 F1/3;
!!PO(x)/(y)/(z):N(fatigue);

!?FU(WOG_Artificer_GetSalePrice);
!#VA(artifact:x) (gold:x) (mithril:x);
!!VR(gold):S0;
!!VR(mithril):S0;
!!FU|(artifact)<0/(artifact)>=(ART_META_SPELLBOOK):E;
!!UN:A(artifact)/1/?(value:y);
!!VR(gold):S(value):4;
!!VR(mithril):S(value):4000+1;
