<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Early repository-wide defaults, loaded by Microsoft.Cpp.Default.props. -->
  <PropertyGroup>
    <ProjectName Condition="'$(ProjectName)' == ''">$(MSBuildProjectName)</ProjectName>

    <LocalGamePath Condition="'$(LocalGamePath)' == ''">D:\games\HoMM 3 ERA</LocalGamePath>
    <LocalGameTestPath Condition="'$(LocalGameTestPath)' == ''">D:\games\HoMM 3 ERA test</LocalGameTestPath>
    <PluginModName Condition="'$(PluginModName)' == ''">WoG</PluginModName>

    <ConfigurationType Condition="'$(ConfigurationType)' == ''">DynamicLibrary</ConfigurationType>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">v143</PlatformToolset>
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)' == ''">10.0</WindowsTargetPlatformVersion>
    <CharacterSet Condition="'$(CharacterSet)' == ''">NotSet</CharacterSet>
    <UseOfMfc Condition="'$(UseOfMfc)' == ''">false</UseOfMfc>

    <!-- Capture command-line/user output overrides before C++ defaults are applied. -->
    <PluginOutDir Condition="'$(PluginOutDir)' == '' AND '$(OutDir)' != ''">$(OutDir)</PluginOutDir>
    <PluginOutDir Condition="'$(PluginOutDir)' == ''">$(LocalGamePath)\Mods\$(PluginModName)\eraplugins\</PluginOutDir>
    <PluginTargetExt Condition="'$(PluginTargetExt)' == ''">.era</PluginTargetExt>
    <TargetName Condition="'$(TargetName)' == ''">$(ProjectName)</TargetName>

    <WarningLevel Condition="'$(WarningLevel)' == ''">Level3</WarningLevel>
    <TreatWarningsAsErrors Condition="'$(TreatWarningsAsErrors)' == ''">false</TreatWarningsAsErrors>
    <SDLCheck Condition="'$(SDLCheck)' == ''">false</SDLCheck>

    <!-- Visual C++ hook: common item definitions must be loaded after Microsoft.Cpp.props. -->
    <ForceImportAfterCppProps>$(MSBuildThisFileDirectory)Directory.Build.after.props</ForceImportAfterCppProps>
    <ForceImportAfterCppTargets>$(MSBuildThisFileDirectory)Directory.Build.after.targets</ForceImportAfterCppTargets>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.props.user"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" />

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <UseDebugLibraries>true</UseDebugLibraries>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
</Project>
